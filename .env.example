# Supabase PostgreSQL connection string. Never commit a real password.
# This separate name avoids Replit's managed DATABASE_URL taking priority.
SUPABASE_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres

# Optional separate local database used only by integration tests.
TEST_DATABASE_URL=

# Server-only Supabase key. Never expose this with a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

YOUTUBE_API_KEY=
WEATHER_API_KEY=
NEWS_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=OpenBento <noreply@openbento.tv>
PORT=5000
